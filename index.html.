
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>For My Birthday Girl 💗</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: Georgia, serif;
  background: linear-gradient(135deg, #ffe0eb, #fff1f6, #f8c4d9);
  color: #a83e6e;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20px;
  overflow-x: hidden;
}

.container {
  width: 100%;
  max-width: 420px;
  background: rgba(255,255,255,.78);
  padding: 30px 22px;
  border-radius: 25px;
  text-align: center;
  box-shadow: 0 10px 40px #c96e9940;
  animation: fadeIn 1s ease;
  position: relative;
  z-index: 2;
}

h1 {
  font-size: 29px;
  color: #d45d91;
}

p {
  line-height: 1.8;
}

input {
  width: 100%;
  padding: 15px;
  border: 2px solid #f1b5cc;
  border-radius: 15px;
  margin: 15px 0;
  text-align: center;
  font-size: 17px;
  outline: none;
  background: #fffafd;
}

button {
  border: none;
  background: #e77da8;
  color: white;
  padding: 14px 24px;
  border-radius: 30px;
  font-size: 16px;
  cursor: pointer;
  transition: .3s;
}

button:active {
  transform: scale(.95);
}

button:hover {
  background: #cf6191;
}

.hidden {
  display: none !important;
}

.small {
  font-size: 13px;
  color: #bd7795;
}

.heart {
  position: fixed;
  bottom: -30px;
  color: #ed91b5;
  animation: floatUp 7s linear infinite;
  pointer-events: none;
  z-index: 1;
}

@keyframes floatUp {
  to {
    transform: translateY(-110vh) rotate(360deg);
    opacity: 0;
  }
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(15px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Envelope */

.envelope-area {
  margin: 45px auto 30px;
  width: 220px;
  height: 155px;
  position: relative;
  cursor: pointer;
  perspective: 800px;
}

.envelope {
  width: 220px;
  height: 140px;
  position: absolute;
  bottom: 0;
  background: #f6a8c5;
  border-radius: 8px;
  box-shadow: 0 8px 15px #d98aaa55;
}

.envelope:before {
  content: "";
  position: absolute;
  inset: 0;
  background: #e982ab;
  clip-path: polygon(0 0, 50% 55%, 100% 0);
  z-index: 3;
  transform-origin: top;
  transition: transform .7s;
}

.envelope:after {
  content: "";
  position: absolute;
  inset: 0;
  background: #f9c0d4;
  clip-path: polygon(0 100%, 50% 48%, 100% 100%);
  z-index: 2;
}

.flap {
  position: absolute;
  inset: 0;
  background: #ec91b5;
  clip-path: polygon(0 0, 100% 0, 50% 58%);
  transform-origin: top;
  transition: transform .7s;
  z-index: 4;
}

.seal {
  position: absolute;
  top: 75px;
  left: 92px;
  font-size: 30px;
  z-index: 5;
  transition: opacity .3s;
}

.envelope.open .flap {
  transform: rotateX(180deg);
}

.envelope.open .seal {
  opacity: 0;
}

.letter {
  background: #fff8fb;
  padding: 24px 19px;
  border-radius: 18px;
  margin-top: 20px;
  line-height: 1.9;
  box-shadow: 0 5px 20px #d98aaa22;
  animation: fadeIn 1s ease;
}

.letter h2 {
  color: #df6e9d;
}

</style>
</head>

<body>

<!-- PASSWORD PAGE -->

<div class="container" id="login">

  <h1>A little surprise for you 💌</h1>

  <p>Heyyy Moluyyhh! 💗</p>

  <p>
    Someone has prepared something special
    just for you...
  </p>

  <p>But first, you need the secret password ♡</p>

  <input
    id="password"
    type="password"
    placeholder="Enter secret password"
  >

  <button onclick="unlock()">
    Unlock my surprise 💗
  </button>

  <p id="error" class="small"></p>

  <p class="small">Made with love ♡</p>

</div>


<!-- SURPRISE PAGE -->

<div class="container hidden" id="surprise">

  <h1>Heyyy Moluyyhh! 💗</h1>

  <p>
    Welcome to your little surprise,
    my girl!
  </p>

  <p>
    I have something special for you...
  </p>

  <h2>💌</h2>

  <p>Tap the envelope to open your letter!</p>

  <div class="envelope-area" onclick="openLetter()">

    <div class="envelope" id="envelope">
      <div class="flap"></div>
      <div class="seal">💗</div>
    </div>

  </div>

  <p class="small">A little letter, just for you ♡</p>

  <!-- LETTER -->

  <div class="letter hidden" id="letter">

    <h2>Happy Birthdayyy! 🎂💗</h2>

    <p>
      Heyyy my Moluyyhh,
      my Vavee Ponneyhh! 💗
    </p>

    <p>
      Happiest birthday to my girl!
      I made this little surprise especially
      for you, hoping it brings a big smile
      to your face.
    </p>

    <p>
      You are so special to me, and I hope
      your birthday is filled with happiness,
      laughter and beautiful memories.
    </p>

    <p>
      Keep smiling, keep being you,
      and never forget how special you are.
    </p>

    <h2>Happy Birthday, my girl! 💕</h2>

    <p>With lots of love ♡</p>

  </div>

</div>


<script>

// PASSWORD

function unlock() {

  const password =
    document.getElementById("password").value;

  if (password.toLowerCase() === "said") {

    document.getElementById("login")
      .classList.add("hidden");

    document.getElementById("surprise")
      .classList.remove("hidden");

  } else {

    document.getElementById("error")
      .textContent =
      "Wrong password! Try again, ponneyh 💗";

  }

}


// ENVELOPE

function openLetter() {

  const envelope =
    document.getElementById("envelope");

  const letter =
    document.getElementById("letter");

  if (letter.classList.contains("hidden")) {

    envelope.classList.add("open");

    setTimeout(function() {
      letter.classList.remove("hidden");
    }, 500);

  }

}


// FLOATING HEARTS

function createHeart() {

  const heart = document.createElement("div");

  heart.className = "heart";

  heart.innerHTML = "♥";

  heart.style.left = Math.random() * 100 + "vw";

  heart.style.fontSize =
    (15 + Math.random() * 20) + "px";

  heart.style.animationDuration =
    (5 + Math.random() * 5) + "s";

  document.body.appendChild(heart);

  setTimeout(function() {
    heart.remove();
  }, 10000);

}

setInterval(createHeart, 700);

</script>

</body>
</html>




